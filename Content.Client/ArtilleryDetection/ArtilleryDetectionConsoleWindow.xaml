<?xml version="1.0" encoding="utf-8"?>
<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="Artillery Detection Log"
                      MinSize="700 600">
    <BoxContainer Orientation="Vertical" Margin="10">
        <!-- Button bar -->
        <BoxContainer Orientation="Horizontal" Margin="0 0 0 10">
            <Button Name="RefreshButton" Text="Refresh" ToggleMode="False" />
            <Button Name="ClearAllButton" Text="Clear All" ToggleMode="False" Margin="5 0 0 0" />
            <Control HorizontalExpand="True" />
        </BoxContainer>

        <!-- Events list -->
        <Label Text="Detected Events" FontColorOverride="#666"/>
        <ScrollContainer VerticalExpand="True" HorizontalExpand="True" Margin="0 5">
            <ItemList Name="EventList" HorizontalExpand="True" />
        </ScrollContainer>

        <!-- Bottom bar -->
        <BoxContainer Orientation="Horizontal" Margin="0 10 0 0">
            <Button Name="DeleteButton" Text="Delete Selected" ToggleMode="False" />
            <Control HorizontalExpand="True" />
            <Label Name="StatusLabel" Text="Ready" />
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
